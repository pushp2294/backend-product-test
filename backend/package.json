{
  "name": "product-catalogue-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the product catalogue PoC. The only component that talks to the product data source.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "5.3.0",
    "nodemailer": "10.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  }
}
