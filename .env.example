# Copy to .env (cp .env.example .env). No real secrets are needed to run locally.

# Port the backend listens on.
PORT=3000

# Where product data comes from:
#   fakestore (default) - the live Fake Store API. Only the backend ever calls it.
#   snapshot            - a dated local copy in backend/snapshot/. Use this if the Fake
#                         Store API is slow or unreachable, or to run fully offline.
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com

# How long product data is cached in memory, in milliseconds. Read at startup:
# change it and restart the backend, no rebuild needed. Default 60000 (60s).
PRODUCT_CACHE_TTL_MS=60000

# Optional: up to 5 comma-separated product ids the merchant has chosen for the
# home page, in display order (e.g. 1,5,9). Leave empty to use the top-rated rule.
# Unknown ids are logged as warnings and their slots filled from the rule.
FEATURED_PRODUCT_IDS=

# How enquiry emails are delivered:
#   file (default) - writes each email to backend/data/enquiries/*.eml and logs a line.
#                    No Docker, no mail server, works everywhere.
#   smtp           - sends via any SMTP server you run (for example Mailpit).
EMAIL_TRANSPORT=file

# SMTP server, used only when EMAIL_TRANSPORT=smtp.
SMTP_HOST=localhost
SMTP_PORT=1025

# Where enquiries are sent, and who they appear to come from.
SALES_INBOX_EMAIL=sales@example.com
EMAIL_FROM=catalogue@example.com
