<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (plain http) is allowed ONLY for two addresses that can only ever reach the
  developer's own machine, where our backend runs locally:
    10.0.2.2   - the Android emulator's alias for the host machine
    127.0.0.1  - a physical phone over USB, via `adb reverse tcp:3000 tcp:3000`
  Everything else stays HTTPS-only. Do not replace this with
  cleartextTrafficPermitted="true" app-wide.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
